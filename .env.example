# Example of the secrets file. Every value in this file is FAKE.
#
# How to use it:
#   1. Make a copy of this file and name the copy ".env" (in the same folder).
#   2. Put the real values in the copy.
# Git ignores ".env", so the real values never reach GitHub.
# Never put a real value in this example file.

# Address and password of our Neon database, in one line.
# Without it the server still runs, and says the database is not set up.
# Only Catarina has the real one. See docs/team-guide.md, section 8.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Email (optional). With these three, a player can add an email address to
# their account and reset a forgotten password. Without them the game runs
# as before, without email. A value that still starts with "replace-with"
# counts as missing.
#
# Our secret key at Brevo, the company that delivers our email.
BREVO_API_KEY=replace-with-the-key-from-brevo
# The address our emails come from. It has to be confirmed at Brevo first.
EMAIL_FROM=replace-with-the-sender-address@example.com
# The address of the game, for the links in emails. On a laptop this is
# right as it is. On Render it is not needed: Render tells the server.
PUBLIC_URL=http://localhost:3000

# Not used.
SESSION_SECRET=replace-with-a-long-random-text
