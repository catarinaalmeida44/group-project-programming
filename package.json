{
  "name": "nova-sbe-kart-racer",
  "version": "0.1.0",
  "description": "2D online kart racing game set at the Nova SBE Carcavelos campus",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/start.js",
    "start:pretend": "node server/start-pretend.js",
    "test": "vitest run",
    "test:database": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/db-live.test.js tests/store-live.test.js"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  },
  "dependencies": {
    "pg": "8.23.1",
    "ws": "8.22.2"
  }
}
