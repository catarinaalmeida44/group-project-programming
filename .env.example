# Example of the secrets file. Every value in this file is FAKE.
#
# How to use it:
#   1. Make a copy of this file and name the copy ".env" (in the same folder).
#   2. Put the real values in the copy.
# Git ignores ".env", so the real values never reach GitHub.
# Never put a real value in this example file.

# Address and password of our Neon database, in one line.
# Not used yet: it is needed from the database step onwards.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Not used yet: accounts and email come after the base.
SESSION_SECRET=replace-with-a-long-random-text
BREVO_API_KEY=replace-with-the-key-from-brevo
